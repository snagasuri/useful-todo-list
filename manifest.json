{
  "manifest_version": 3,
  "name": "finally",
  "version": "1.0",
  "description": "Simple to-do list extension that replaces the new tab page",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://api.balldontlie.io/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
